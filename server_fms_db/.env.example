APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
TELEMETRY_HOST=0.0.0.0
TELEMETRY_PORT=8001
# Vision PC → FMS global vision status receiver (UDP / UTF-8 JSON / 1 Hz)
VISION_STATUS_UDP_HOST=0.0.0.0
VISION_STATUS_UDP_PORT=20050
# Incoming QA v0.2 is a separate FMS UDP transaction channel. Leave every
# value unset to keep this runtime disabled; no Vision destination is inferred.
# VISION_INCOMING_QA_UDP_HOST=
# VISION_INCOMING_QA_UDP_PORT=
# FMS_INCOMING_QA_RESULT_UDP_HOST=
# FMS_INCOMING_QA_RESULT_UDP_PORT=
# INCOMING_QA_UDP_ACK_TIMEOUT_SECONDS=
# INCOMING_QA_UDP_MAX_RETRIES=
# FMS → Vision Incoming Material QA Request (HTTP 202 ACK; terminal result uses callback to API :8000)
VISION_INCOMING_QA_BASE_URL=http://192.168.20.30:8010
VISION_INCOMING_QA_REQUEST_PATH=/api/v1/incoming-qa/requests
# Provisional runtime transport defaults; retry always reuses the same request ID/snapshot.
VISION_INCOMING_QA_TIMEOUT_SECONDS=10
VISION_INCOMING_QA_MAX_ATTEMPTS=2
VISION_INCOMING_QA_RETRY_DELAY_SECONDS=0.5
# Factory Stack Launcher reads v0.2 UDP keys only in its actual Vision profile.
# It never provides real Vision host/port defaults.
# PRE_ROOF v0.1 is a wholly separate FMS UDP boundary. Leave unset unless the
# FMS is deliberately configured for the Vision PRE_ROOF gateway.
# VISION_PRE_ROOF_UDP_HOST=
# VISION_PRE_ROOF_UDP_PORT=
# FMS_PRE_ROOF_RESULT_UDP_HOST=
# FMS_PRE_ROOF_RESULT_UDP_PORT=
# Local listener bind only; this is not advertised to Vision. Defaults to
# 0.0.0.0 when omitted, so it need not be an actual-profile required setting.
FMS_PRE_ROOF_RESULT_UDP_BIND_HOST=0.0.0.0
# PRE_ROOF_UDP_ACK_TIMEOUT_SECONDS=
# PRE_ROOF_UDP_MAX_RETRIES=
# Auxiliary realtime cache and process-to-process event bus only.
# PostgreSQL remains the production source of truth.
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql+psycopg://smart_factory_dev:change_me@localhost:5432/smart_factory_db
TELEMETRY_ROS_ENABLED=false
UNITY_REDIS_CHANNEL_PREFIX=
# Dedicated PostgreSQL integration-test database only. Do not point this at the
# development database. This value belongs in the local .env, not in Git.
POSTGRES_TEST_DATABASE_URL=
# Explicit local disposable target for PRE_ROOF/full-stack rehearsals only.
FACTORY_REHEARSAL_DATABASE_URL=
# Separate disposable database for the operator execution-gate GUI rehearsal.
OPERATOR_GATE_REHEARSAL_DATABASE_URL=
TEST_OVERRIDE_ENABLED=false
PENDING_PRODUCTION_REQUEST_TTL_SECONDS=300
ROS_DOMAIN_ID=73
# Worker logistics scheduling: disabled preserves legacy serial execution.
# Set one_ahead only where Base/Robot execution may overlap a future material transport.
MATERIAL_PREFETCH_MODE=disabled
CELL_EXECUTE_TASK_ACTION_NAME=/cell/execute_task
CELL_ACTION_SERVER_WAIT_TIMEOUT_SECONDS=5
CELL_ACTION_RESULT_TIMEOUT_SECONDS=60
# TurtleBot logical identity and ROS interfaces. mobile_robot_pose is ROS →
# Telemetry Gateway → Redis → API /ws/unity; it is never persisted to PostgreSQL.
TURTLEBOT_ROBOT_ID=forklift_01
TURTLEBOT_FRAME_ID=map
FORKLIFT_EXECUTE_TRANSPORT_ACTION_NAME=/forklift/execute_transport
FORKLIFT_RETURN_HOME_ACTION_NAME=/forklift/return_home
FORKLIFT_MOBILE_ROBOT_POSE_TOPIC=/forklift/mobile_robot_pose

# LLM / STT (leave OLLAMA_MODEL empty until verified with `ollama list`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=ko
WHISPER_BEAM_SIZE=5
MAX_AUDIO_FILE_MB=20
AI_DEBUG_RESPONSE=false

# TTS (edge-tts is an online provider; choose a verified ko-KR voice locally)
TTS_PROVIDER=edge
TTS_VOICE=
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz
TTS_TIMEOUT_SECONDS=30
TTS_MAX_TEXT_LENGTH=500
