# =============================================================================
# ros2-ai-cobot-repo2 — 통합 저장소
# (AI Perception / 관제 GUI / TurtleBot3 지게차 / LLM·STT·TTS / FR5·ZeKeep 제어)
#
# 주의 1) .gitignore 는 줄 끝 인라인 주석을 지원하지 않는다.
#          "config/*.yaml   # 주석"  → '# 주석'까지 패턴에 포함되어 아무것도 안 걸린다.
#          주석은 반드시 별도 줄에 쓸 것.
# 주의 2) git 은 대소문자를 구분한다. Unity 는 Build/ Logs/ 처럼 대문자로 시작한다.
#          ROS2 의 build/ log/ 와 별개 규칙이 필요하다. → [Bb] 형태로 둘 다 잡는다.
# 주의 3) 티칭 자세 · 캘리브 결과 · 맵은 재현에 필수다. 무시 규칙을 두지 않는다.
# =============================================================================


# =============================================================================
# 공통
# =============================================================================

# ── 에디터 / IDE / OS ───────────────────────────────────────────────────────
.vscode/
.idea/
.vs/
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tempCodeRunnerFile.py

# ── 시크릿 / 환경변수 ───────────────────────────────────────────────────────
# 절대 커밋 금지. .env.example 을 만들어 키 이름만 공유할 것.
.env
.env.*
!.env.example
.envrc
*.pem
*.key
!*.pub
.pypirc

# ── 백업 규약 ───────────────────────────────────────────────────────────────
# 수정 전 `cp <파일> <파일>.BEFORE_<변경내용>` 로 로컬 사본을 남긴다.
# 되돌리기용이며 git history 가 그 역할을 대신하므로 커밋하지 않는다.
# 접미사에 숫자/설명이 붙는 변종이 많아 뒤에 * 를 둔다.
*.BEFORE_*
*.PREV*
*.BAK*
*.bak
*_backup_*/

# ── 압축 / 대용량 산출물 ────────────────────────────────────────────────────
# 원본이 필요하면 Git LFS 를 쓸 것 (git lfs track "*.tar.gz")
*.tar.gz
*.zip
*.7z
*.rar


# =============================================================================
# ROS2 공통 (ai_perception / forklift_turtlebot3 / robot_control_fr5_zekeep)
# =============================================================================

# ── colcon 빌드 산출물 ──────────────────────────────────────────────────────
# src/ 안에도 중첩 생성되므로 앞에 / 를 붙이지 않는다(어느 깊이든 매칭).
build/
install/
log/

# ── 실행 산출물 ─────────────────────────────────────────────────────────────
run_logs/
*.log
.ros/

# ── rosbag ─────────────────────────────────────────────────────────────────
*.db3
*.mcap
rosbag2_*/


# =============================================================================
# 로봇 제어 (FR5 / ZeKeep)
# =============================================================================

# ── ★티칭 자세 · 캘리브 결과는 반드시 커밋 ─────────────────────────────────
# 자세 DB, TCP · 페이로드 설정, 카메라 캘리브 결과(fx/cx)가 빠지면
# 다른 사람이 파지 · 삽입을 재현할 수 없다. 무시 규칙을 두지 않는다.

# ── 런타임 상태 / 세션 산출물 ───────────────────────────────────────────────
# 사이클마다 갱신되는 현재 상태값이라 커밋 대상이 아니다.
state/
runtime/
*.pid


# =============================================================================
# TurtleBot3 지게차 (forklift_turtlebot3)
# =============================================================================

# ── ★맵 / 순찰 · 운반 경로는 반드시 커밋 ───────────────────────────────────
# *.pgm 을 통째로 무시하면 map.pgm 이 빠져 주행을 재현할 수 없다.
# 맵 원본(.pgm/.yaml)과 경로 정의는 커밋한다.


# =============================================================================
# AI Perception (Vision)
# =============================================================================

# ── ★모델 가중치 (수백 MB — GitHub 파일당 100MB 제한) ───────────────────────
# Git LFS 로 관리하거나, 릴리즈 · 외부 스토리지에 두고 다운로드 스크립트를 커밋할 것.
*.pt
*.pth
*.onnx
*.engine
*.trt
*.weights
*.h5
*.pb
*.tflite
*.caffemodel

# ── 데이터셋 / 캡쳐 / 검증 이미지 ───────────────────────────────────────────
# Golden 기준 이미지처럼 검사에 필요한 파일은 개별 경로로 예외 처리할 것.
datasets/
captures/
snapshots/
evidence/
runs/
*.npy
*.mp4
*.avi
*.mov

# ── DB ─────────────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
instance/


# =============================================================================
# LLM / STT / TTS
# =============================================================================

# ── 모델 캐시 (수 GB, 자동 재다운로드된다) ──────────────────────────────────
.cache/
models/
whisper_models/
huggingface/
*.gguf
*.bin
*.ckpt
*.safetensors

# ── 음성 입출력 산출물 ──────────────────────────────────────────────────────
# 실행할 때마다 생기는 녹음 · 합성 결과. 샘플이 필요하면 assets/ 에 둘 것.
audio_out/
recordings/
*.wav
*.mp3
*.flac
*.ogg


# =============================================================================
# 관제 GUI (controltower_gui)
# =============================================================================

# ── Qt Designer 자동 생성 파일 ──────────────────────────────────────────────
# pyuic / pyrcc 로 매번 재생성되는 파일만 무시한다.
# `*_ui.py` 처럼 넓게 잡으면 다른 영역의 실제 소스까지 걸리므로 쓰지 않는다.
controltower_gui/**/ui_*.py
controltower_gui/**/*_rc.py

# ── Node / 웹 프론트 ────────────────────────────────────────────────────────
node_modules/
.next/
.nuxt/
.pnpm-store/
npm-debug.log*
yarn-error.log*

# ── Unity 로 구현하는 경우 ──────────────────────────────────────────────────
# *.meta 는 절대 무시하지 말 것(에셋 참조가 통째로 깨진다).
# 아래 어떤 규칙도 .meta 를 잡지 않는다.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.unitypackage
*.apk
*.aab
*.app
sysinfo.txt


# =============================================================================
# Python 공통
# =============================================================================

__pycache__/
*.py[codz]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
sdist/
wheels/
.installed.cfg
MANIFEST
.venv
venv/
env/
ENV/

# ── 테스트 / 정적분석 / 커버리지 ────────────────────────────────────────────
.pytest_cache/
.cache
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
cython_debug/

# ── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints
profile_default/
ipython_config.py


# =============================================================================
# 문서 / 로컬 도구
# =============================================================================

# ── 내부 문서는 커밋하지 않는다 ─────────────────────────────────────────────
# 런북 · 회의록 · 검증노트는 개인 · 로컬 산출물이라 저장소를 어지럽힌다.
# README.md 와 각 영역의 docs/ 는 예외.
*.md
!README.md
!**/README.md
!**/docs/*.md

*.docx
*.pptx
*.xlsx
*.hwp

docs/_build/
/site

# ── 로컬 도구 설정 ──────────────────────────────────────────────────────────
CLAUDE.md
.claude/
.codex/
.cursor/

# ── 디버깅 잔재 ─────────────────────────────────────────────────────────────
*.xwd
ksnip_*.png
