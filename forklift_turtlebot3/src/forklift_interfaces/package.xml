<?xml version="1.0"?>
<package format="3">
  <name>forklift_interfaces</name>
  <version>0.2.0</version>
  <description>ROS2 messages and actions for TurtleBot forklift missions, docking, and lift control.</description>
  <maintainer email="eduwing-robotics@users.noreply.github.com">forklift_turtlebot3 team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <depend>geometry_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
